# ============================================================
# Zinviq — Environment Variables
# Copy this file to .env.local for local development
# Add these in Netlify Dashboard > Site configuration > Environment variables
# ============================================================

# Email Service (Resend — https://resend.com)
# REQUIRED IN PRODUCTION. Without it, /api/contact returns 502 instead of faking success.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender domain in Resend
EMAIL_FROM=Zinviq Growth Leads <leads@zinviq.com>

# The inbox that receives contact form submissions
CONTACT_RECEIVER_EMAIL=growth@zinviq.com

# Persistent rate limiting (REQUIRED IN PRODUCTION).
# In-memory limits do not work across serverless invocations.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Canonical public host. Use https://zinviq.netlify.app until zinviq.com resolves,
# then switch this value and redirect the Netlify host to the custom domain.
NEXT_PUBLIC_SITE_URL=https://zinviq.netlify.app

# WhatsApp number in international format, digits only. Leave blank to hide the button.
# Example for Pakistan: 923001234567 | Example for USA: 12125550123
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Spam protection (Cloudflare Turnstile — https://dash.cloudflare.com > Turnstile)
# Both values are required to enable the visible widget and server-side verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Social profile URLs used by Organization schema. Leave blank for profiles that do not exist.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Google Tag Manager container GTM-WNZS3ZJG is hardcoded in src/lib/analytics.ts.
# It loads only after the visitor accepts analytics consent in the cookie banner.
# GSC/Bing verification tokens are already committed as meta tags in src/app/layout.tsx.
